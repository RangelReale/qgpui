{
  "name": "questports-payload",
  "version": "0.1.0",
  "private": true,
  "description": "Builds one JSON file that joins the QuestPorts game list with each game's install requirements.",
  "type": "module",
  "bin": {
    "questports-payload": "src/main.mjs",
    "qgpui-catalog": "src/build-catalog.mjs"
  },
  "scripts": {
    "build-payload": "node src/main.mjs",
    "build-catalog": "node src/build-catalog.mjs",
    "check-recipes": "node src/check-recipes.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "esbuild": "0.25.10"
  }
}
